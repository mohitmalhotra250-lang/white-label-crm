{
  "version": 2,
  "builds": [{ "src": "frontend/package.json", "use": "@vercel/next" }],
  "routes": [
    { "src": "/(.*)", "dest": "/frontend/$1" }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.yourdomain.com"
  },
  "regions": ["iad1"],
  "buildCommand": "npm run build",
  "outputDirectory": ".next"
}
