# Production Deployment Environment — White-Label AI CRM
# Stack: Vercel (Frontend) + Neon PostgreSQL + Upstash Redis + Supabase Storage
# Domain: configure in Vercel + DNS after deployment

# Frontend (Vercel)
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# Backend (Vercel Serverless / Docker / Fly.io / Render)
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://user:password@neon-host.neon.tech/universal_crm?sslmode=require
REDIS_URL=rediss://default:password@upstash-redis-host.upstash.io:6379
JWT_SECRET=REPLACE_WITH_256BIT_SECRET_KEY
WEBHOOK_SECRET=REPLACE_WITH_STRONG_WEBHOOK_SECRET
ENCRYPTION_KEY=REPLACE_32CHAR_KEY
S3_BUCKET=your-supabase-bucket-name
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# Provider API Keys (encrypted at rest in DB — add via /api/admin/providers after deploy)
VAPI_API_KEY=sk-... (configure via admin)
RETELL_API_KEY=sk-... (configure via admin)
BLAND_API_KEY=sk-... (configure via admin)

# CORS / Security
ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
HTTPS_ONLY=true
